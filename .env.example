# 首次啟動時建立管理者；必須更換密碼（至少 12 字元）。
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-random-password
# 對外網址用於信件連結；啟用 HTTPS 時 COOKIE_SECURE=true。
PUBLIC_URL=http://localhost:3000
COOKIE_SECURE=false
PORT=3000
BIND_ADDRESS=127.0.0.1
DATABASE_PATH=data/ezstorage.sqlite
# 預設由管理者建立借用人，不開放自行註冊。
ALLOW_REGISTRATION=false
# 僅首次初始化使用；true 載入明確標示的示範教具。
SEED_DEMO=false
# 不填 SMTP_HOST 時只保留站內通知，不會寄出 Email。
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
