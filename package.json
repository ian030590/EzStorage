{
  "name": "ezstorage",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted spatial teaching inventory and borrowing system",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --watch --env-file-if-exists=.env server/index.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "node scripts/browser-qa.cjs"
  },
  "license": "MIT",
  "dependencies": {
    "express": "5.2.1",
    "nodemailer": "10.6.0",
    "qrcode": "1.5.4",
    "three": "0.184.0"
  },
  "devDependencies": {
    "jsdom": "30.1.1",
    "playwright-core": "1.64.1"
  }
}
