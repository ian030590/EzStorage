{
  "name": "ezstorage",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted spatial teaching inventory and borrowing system",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "build:demo": "node scripts/build.ts --demo",
    "typecheck": "tsc --noEmit",
    "start": "node --env-file-if-exists=.env server/index.ts",
    "dev": "npm run build && node --watch --env-file-if-exists=.env server/index.ts",
    "pretest": "npm run build",
    "test": "node --test tests/*.test.ts",
    "test:browser": "npm run build && node scripts/browser-qa.ts"
  },
  "license": "MIT",
  "dependencies": {
    "express": "5.2.1",
    "nodemailer": "10.6.0",
    "qrcode": "1.5.4",
    "three": "0.184.0"
  },
  "devDependencies": {
    "@types/node": "24.13.2",
    "@types/qrcode": "1.5.6",
    "@types/three": "0.184.1",
    "esbuild": "0.28.2",
    "jsdom": "30.1.1",
    "playwright-core": "1.64.1",
    "typescript": "6.0.3"
  },
  "type": "module"
}
